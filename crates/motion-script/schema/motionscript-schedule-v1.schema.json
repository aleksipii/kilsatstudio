{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "script": {
      "type": "object",
      "description": "Existing MotionScript Script schema; validated by motion_script::parse. This schema checks only the scheduling envelope."
    },
    "schedules": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "required": [
    "version",
    "script",
    "schedules"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "seq"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "op",
            "children"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "par"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "$ref": "#/$defs/node"
              }
            }
          },
          "required": [
            "op",
            "children"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "stagger"
            },
            "children": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1024,
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "delay": {
              "oneOf": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+f$",
                  "description": "Whole frames at the project fps, such as 3f."
                }
              ]
            }
          },
          "required": [
            "op",
            "children",
            "delay"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "wait"
            },
            "duration": {
              "oneOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+f$",
                  "description": "Whole frames at the project fps, such as 3f."
                }
              ]
            }
          },
          "required": [
            "op",
            "duration"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "event"
            },
            "span": {
              "oneOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "string",
                  "pattern": "^[0-9]+f$",
                  "description": "Whole frames at the project fps, such as 3f."
                }
              ]
            },
            "event": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "move"
                    },
                    "actor": {
                      "type": "string"
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "arc": {
                      "type": "number",
                      "minimum": -0.5,
                      "maximum": 0.5,
                      "description": "Circular-arc bulge as a fraction of the straight distance; positive bulges up on screen."
                    },
                    "bezier": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 2,
                      "description": "One (quadratic) or two (cubic) Bezier control points in canvas pixels.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "x": {
                            "type": "number"
                          },
                          "y": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "x",
                          "y"
                        ]
                      }
                    }
                  },
                  "required": [
                    "type",
                    "actor",
                    "at",
                    "duration",
                    "x",
                    "y"
                  ],
                  "not": {
                    "required": [
                      "arc",
                      "bezier"
                    ]
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "gesture"
                    },
                    "actor": {
                      "type": "string"
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0
                    },
                    "duration": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "actor",
                    "at",
                    "duration",
                    "value"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "emotion"
                    },
                    "actor": {
                      "type": "string"
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0
                    },
                    "value": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "actor",
                    "at",
                    "value"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "const": "speak"
                    },
                    "actor": {
                      "type": "string"
                    },
                    "at": {
                      "type": "number",
                      "minimum": 0
                    },
                    "text": {
                      "type": "string"
                    },
                    "emotion": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "audio": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "actor",
                    "at",
                    "text"
                  ]
                }
              ]
            }
          },
          "required": [
            "op",
            "span",
            "event"
          ]
        }
      ]
    }
  },
  "title": "MotionScript scheduling envelope v1"
}
