{
  "format_version": 2,
  "source": "animation_clips: {}\n\nproject:\n  title: Night room reference (original art)\n  fps: 24\n  width: 640\n  height: 360\n  captions:\n    enabled: true\n    font_size: 28.0\n    fill: '#ffffff'\n    speaker_fill: {DAD: '#ffffff', STAN: '#ffd400'}\n    outline: '#000000'\n    outline_width: 3.0\n    bottom_margin: 0.025\n    max_width: 0.8\n    line_height: 1.1\n    uppercase: true\n    background: '#15121f'\n\ncharacters:\n  DAD:\n    default_pose: null\n    asset: characters/dad-cutout\n    rig:\n      version: 1\n      id: dad_cutout\n      joints:\n        - {id: root, parent: null, x: 0.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0}\n        - {id: torso, parent: root, x: 0.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0}\n        - {id: head, parent: torso, x: 0.0, y: -86.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0}\n        - {id: arm_l, parent: torso, x: -38.0, y: -70.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0}\n        - {id: arm_r, parent: torso, x: 38.0, y: -70.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0}\n      parts:\n        - id: trousers_l\n          joint: root\n          points: [[-32.0, 18.0], [-4.0, 18.0], [-6.0, 110.0], [-30.0, 110.0]]\n          color: [50, 50, 60, 255]\n          smooth: 2\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.8\n            mode: behind\n        - id: trousers_r\n          joint: root\n          points: [[4.0, 18.0], [32.0, 18.0], [30.0, 110.0], [6.0, 110.0]]\n          color: [50, 50, 60, 255]\n          smooth: 2\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.8\n            mode: behind\n        - id: work_shirt\n          joint: torso\n          points: [[-28.0, -88.0], [28.0, -88.0], [40.0, -74.0], [44.0, 24.0], [-44.0, 24.0], [-40.0, -74.0]]\n          color: [76, 66, 65, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.8\n            mode: behind\n        - id: collar\n          joint: torso\n          points: [[-14.0, -86.0], [14.0, -86.0], [0.0, -66.0]]\n          color: [44, 37, 42, 255]\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.1\n        - id: chest_pocket\n          joint: torso\n          points: [[10.0, -56.0], [28.0, -56.0], [28.0, -38.0], [10.0, -38.0]]\n          color: [60, 50, 54, 255]\n          smooth: 2\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.1\n        - id: sleeve_l\n          joint: arm_l\n          points: [[-9.0, -4.0], [9.0, -4.0], [8.0, 60.0], [-8.0, 60.0]]\n          color: [76, 66, 65, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.6\n            mode: behind\n        - id: hand_l\n          joint: arm_l\n          color: [154, 119, 109, 255]\n          ellipse: {cx: 0.0, cy: 66.0, rx: 8.0, ry: 9.0}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.4\n            mode: behind\n        - id: sleeve_r\n          joint: arm_r\n          points: [[-9.0, -4.0], [9.0, -4.0], [8.0, 60.0], [-8.0, 60.0]]\n          color: [76, 66, 65, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.6\n            mode: behind\n        - id: hand_r\n          joint: arm_r\n          color: [154, 119, 109, 255]\n          ellipse: {cx: 0.0, cy: 66.0, rx: 8.0, ry: 9.0}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.4\n            mode: behind\n        - id: head_skin\n          joint: head\n          color: [154, 119, 109, 255]\n          ellipse: {cx: 0.0, cy: -30.0, rx: 31.0, ry: 32.0}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.8\n            mode: behind\n        - id: hair\n          joint: head\n          points:\n            - [-31.0, -42.0]\n            - [-30.0, -56.0]\n            - [-16.0, -67.0]\n            - [16.0, -67.0]\n            - [30.0, -56.0]\n            - [31.0, -42.0]\n            - [22.0, -52.0]\n            - [0.0, -56.0]\n            - [-22.0, -52.0]\n          color: [50, 36, 30, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.6\n            mode: behind\n        - id: eye_l\n          joint: head\n          color: [244, 244, 248, 255]\n          variants:\n            blink:\n              color: [154, 119, 109, 255]\n          ellipse: {cx: -12.0, cy: -31.0, rx: 8.5, ry: 9.0}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.4\n        - id: pupil_l\n          joint: head\n          color: [30, 24, 40, 255]\n          variants:\n            blink:\n              color: [30, 24, 40, 0]\n          ellipse: {cx: -12.0, cy: -31.0, rx: 2.8, ry: 3.4}\n        - id: eye_r\n          joint: head\n          color: [244, 244, 248, 255]\n          variants:\n            blink:\n              color: [154, 119, 109, 255]\n          ellipse: {cx: 12.0, cy: -31.0, rx: 8.5, ry: 9.0}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.4\n        - id: pupil_r\n          joint: head\n          color: [30, 24, 40, 255]\n          variants:\n            blink:\n              color: [30, 24, 40, 0]\n          ellipse: {cx: 12.0, cy: -31.0, rx: 2.8, ry: 3.4}\n        - id: brow_l\n          joint: head\n          points: [[-19.975, -42.6], [-5.025, -42.6], [-5.025, -38.4], [-19.975, -38.4]]\n          color: [50, 36, 30, 255]\n          variants:\n            angry:\n              points: [[-19.975, -44.0], [-5.025, -38.4], [-5.025, -34.2], [-19.975, -39.8]]\n            raised:\n              points: [[-19.975, -48.2], [-5.025, -48.2], [-5.025, -44.0], [-19.975, -44.0]]\n            worried:\n              points: [[-19.975, -41.2], [-5.025, -48.2], [-5.025, -44.0], [-19.975, -37.0]]\n          smooth: 2\n        - id: brow_r\n          joint: head\n          points: [[5.025, -42.6], [19.975, -42.6], [19.975, -38.4], [5.025, -38.4]]\n          color: [50, 36, 30, 255]\n          variants:\n            angry:\n              points: [[5.025, -38.4], [19.975, -44.0], [19.975, -39.8], [5.025, -34.2]]\n            raised:\n              points: [[5.025, -48.2], [19.975, -48.2], [19.975, -44.0], [5.025, -44.0]]\n            worried:\n              points: [[5.025, -48.2], [19.975, -41.2], [19.975, -37.0], [5.025, -44.0]]\n          smooth: 2\n        - id: mouth\n          joint: head\n          points: [[-6.0, -6.6], [6.0, -6.6], [5.0, -3.4], [-5.0, -3.4]]\n          color: [30, 18, 27, 255]\n          variants:\n            a:\n              points:\n                - [-5.0, -9.8]\n                - [5.0, -9.8]\n                - [8.0, -7.4]\n                - [8.0, -2.6]\n                - [5.0, 0.6]\n                - [-5.0, 0.6]\n                - [-8.0, -2.6]\n                - [-8.0, -7.4]\n              color: [30, 18, 27, 255]\n            closed:\n              points: [[-7.0, -5.8], [0.0, -5.0], [7.0, -5.8], [6.0, -4.2], [0.0, -3.4], [-6.0, -4.2]]\n              color: [30, 18, 27, 255]\n            e:\n              points: [[-7.0, -8.2], [6.0, -8.2], [9.0, -5.8], [7.0, -1.8], [-6.0, -1.0], [-9.0, -4.2]]\n              color: [30, 18, 27, 255]\n            i:\n              points: [[-9.0, -6.6], [7.0, -6.6], [10.0, -5.0], [8.0, -2.6], [-8.0, -2.6], [-10.0, -5.0]]\n              color: [30, 18, 27, 255]\n            o:\n              points:\n                - [-3.0, -9.8]\n                - [3.0, -9.8]\n                - [6.0, -7.4]\n                - [7.0, -4.2]\n                - [4.0, -0.2]\n                - [-3.0, -0.2]\n                - [-6.0, -2.6]\n                - [-6.0, -6.6]\n              color: [30, 18, 27, 255]\n            r:\n              points: [[-4.0, -8.2], [4.0, -8.2], [6.0, -5.8], [4.0, -2.6], [-4.0, -1.8], [-6.0, -5.0]]\n              color: [30, 18, 27, 255]\n            sh:\n              points: [[-2.0, -8.2], [3.0, -8.2], [6.0, -5.8], [4.0, -1.8], [-3.0, -1.8], [-5.0, -5.0]]\n              color: [30, 18, 27, 255]\n            sibilant:\n              points: [[-7.0, -6.2], [7.0, -6.2], [6.0, -3.4], [-6.0, -3.4]]\n              color: [225, 210, 205, 255]\n            teeth_lip:\n              points: [[-6.0, -6.6], [6.0, -6.6], [5.0, -2.6], [-5.0, -2.6]]\n              color: [235, 225, 215, 255]\n            tongue_teeth:\n              points: [[-5.0, -6.6], [5.0, -6.6], [5.0, -2.6], [-5.0, -2.6]]\n              color: [210, 110, 120, 255]\n            tongue_up:\n              points: [[-5.0, -7.4], [5.0, -7.4], [6.0, -2.6], [-6.0, -2.6]]\n              color: [190, 90, 100, 255]\n            u:\n              points:\n                - [-2.0, -8.2]\n                - [2.0, -8.2]\n                - [4.0, -6.6]\n                - [4.0, -3.4]\n                - [2.0, -1.8]\n                - [-2.0, -1.8]\n                - [-4.0, -3.4]\n                - [-4.0, -6.6]\n              color: [30, 18, 27, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.0\n        - id: moustache\n          joint: head\n          points: [[-14.0, -14.0], [14.0, -14.0], [11.0, -8.0], [0.0, -10.0], [-11.0, -8.0]]\n          color: [50, 36, 30, 255]\n          smooth: 2\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.1\n      visemes:\n        part: mouth\n        map:\n          a: a\n          closed: closed\n          e: e\n          i: i\n          o: o\n          r: r\n          sh: sh\n          sibilant: sibilant\n          teeth_lip: teeth_lip\n          tongue_teeth: tongue_teeth\n          tongue_up: tongue_up\n          u: u\n      expressions:\n        angry:\n          - {part: brow_l, variant: angry}\n          - {part: brow_r, variant: angry}\n        sad:\n          - {part: brow_l, variant: worried}\n          - {part: brow_r, variant: worried}\n        surprised:\n          - {part: brow_l, variant: raised}\n          - {part: brow_r, variant: raised}\n      eyes:\n        pupils: [pupil_l, pupil_r]\n        travel: 3.0\n        blink:\n          parts: [eye_l, eye_r, pupil_l, pupil_r]\n          variant: blink\n          interval: 2.3\n          duration: 0.14\n    voice: null\n  STAN:\n    default_pose: null\n    asset: characters/stan-cutout\n    rig:\n      version: 1\n      id: stan_cutout\n      joints:\n        - {id: root, parent: null, x: 0.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0}\n        - {id: torso, parent: root, x: 0.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0}\n        - {id: head, parent: torso, x: 0.0, y: -60.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0}\n        - {id: arm, parent: torso, x: 24.0, y: -52.0, rotation: 0.35, scale_x: 1.0, scale_y: 1.0}\n        - {id: hand, parent: arm, x: 0.0, y: 32.0, rotation: -0.35, scale_x: 1.0, scale_y: 1.0}\n      parts:\n        - id: pyjama_top\n          joint: torso\n          points:\n            - [-20.0, -66.0]\n            - [20.0, -66.0]\n            - [30.0, -58.0]\n            - [32.0, -30.0]\n            - [36.0, 14.0]\n            - [-36.0, 14.0]\n            - [-32.0, -30.0]\n            - [-30.0, -58.0]\n          color: [60, 100, 190, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.8\n            mode: behind\n        - id: football_patch_a\n          joint: torso\n          points: [[-18.0, -30.0], [-10.0, -34.0], [-3.0, -28.0], [-5.0, -18.0], [-15.0, -17.0]]\n          color: [235, 235, 235, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.1\n        - id: football_patch_b\n          joint: torso\n          points: [[8.0, -8.0], [16.0, -12.0], [23.0, -6.0], [21.0, 3.0], [11.0, 4.0]]\n          color: [235, 235, 235, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.1\n        - id: sleeve\n          joint: arm\n          points: [[-8.0, -4.0], [8.0, -4.0], [8.0, 34.0], [-8.0, 34.0]]\n          color: [50, 86, 170, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.6\n            mode: behind\n        - id: hand_skin\n          joint: hand\n          color: [240, 196, 160, 255]\n          ellipse: {cx: 0.0, cy: 5.0, rx: 19.5, ry: 8.5}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.4\n            mode: behind\n        - id: phone_body\n          joint: hand\n          points:\n            - [-13.0, -16.0]\n            - [13.0, -16.0]\n            - [16.0, -16.0]\n            - [16.0, -13.0]\n            - [16.0, 29.0]\n            - [16.0, 32.0]\n            - [13.0, 32.0]\n            - [-13.0, 32.0]\n            - [-16.0, 32.0]\n            - [-16.0, 29.0]\n            - [-16.0, -13.0]\n            - [-16.0, -16.0]\n          color: [28, 28, 36, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.4\n            mode: behind\n        - id: head_skin\n          joint: head\n          color: [240, 196, 160, 255]\n          ellipse: {cx: 0.0, cy: -21.0, rx: 28.0, ry: 27.0}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.8\n            mode: behind\n        - id: eye_l\n          joint: head\n          color: [244, 244, 248, 255]\n          variants:\n            blink:\n              color: [240, 196, 160, 255]\n          ellipse: {cx: -10.0, cy: -22.5, rx: 9.0, ry: 10.0}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.4\n        - id: pupil_l\n          joint: head\n          color: [30, 24, 40, 255]\n          variants:\n            blink:\n              color: [30, 24, 40, 0]\n          ellipse: {cx: -10.0, cy: -22.5, rx: 2.8, ry: 3.4}\n        - id: eye_r\n          joint: head\n          color: [244, 244, 248, 255]\n          variants:\n            blink:\n              color: [240, 196, 160, 255]\n          ellipse: {cx: 10.0, cy: -22.5, rx: 9.0, ry: 10.0}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.4\n        - id: pupil_r\n          joint: head\n          color: [30, 24, 40, 255]\n          variants:\n            blink:\n              color: [30, 24, 40, 0]\n          ellipse: {cx: 10.0, cy: -22.5, rx: 2.8, ry: 3.4}\n        - id: brow_l\n          joint: head\n          points: [[-17.0, -35.5], [-4.0, -35.5], [-4.0, -33.0], [-17.0, -33.0]]\n          color: [40, 26, 26, 255]\n          variants:\n            angry:\n              points: [[-17.0, -37.0], [-4.0, -31.0], [-4.0, -28.5], [-17.0, -34.5]]\n            raised:\n              points: [[-17.0, -38.5], [-4.0, -38.5], [-4.0, -36.0], [-17.0, -36.0]]\n            worried:\n              points: [[-17.0, -34.0], [-4.0, -40.5], [-4.0, -38.0], [-17.0, -31.5]]\n          smooth: 2\n        - id: brow_r\n          joint: head\n          points: [[4.0, -35.5], [17.0, -35.5], [17.0, -33.0], [4.0, -33.0]]\n          color: [40, 26, 26, 255]\n          variants:\n            angry:\n              points: [[4.0, -31.0], [17.0, -37.0], [17.0, -34.5], [4.0, -28.5]]\n            raised:\n              points: [[4.0, -38.5], [17.0, -38.5], [17.0, -36.0], [4.0, -36.0]]\n            worried:\n              points: [[4.0, -40.5], [17.0, -34.0], [17.0, -31.5], [4.0, -38.0]]\n          smooth: 2\n        - id: mouth\n          joint: head\n          points: [[-6.0, -8.0], [6.0, -8.0], [5.0, -4.0], [-5.0, -4.0]]\n          color: [30, 18, 27, 255]\n          variants:\n            a:\n              points:\n                - [-5.0, -12.0]\n                - [5.0, -12.0]\n                - [8.0, -9.0]\n                - [8.0, -3.0]\n                - [5.0, 1.0]\n                - [-5.0, 1.0]\n                - [-8.0, -3.0]\n                - [-8.0, -9.0]\n              color: [30, 18, 27, 255]\n            closed:\n              points: [[-7.0, -7.0], [0.0, -6.0], [7.0, -7.0], [6.0, -5.0], [0.0, -4.0], [-6.0, -5.0]]\n              color: [30, 18, 27, 255]\n            e:\n              points: [[-7.0, -10.0], [6.0, -10.0], [9.0, -7.0], [7.0, -2.0], [-6.0, -1.0], [-9.0, -5.0]]\n              color: [30, 18, 27, 255]\n            i:\n              points: [[-9.0, -8.0], [7.0, -8.0], [10.0, -6.0], [8.0, -3.0], [-8.0, -3.0], [-10.0, -6.0]]\n              color: [30, 18, 27, 255]\n            o:\n              points:\n                - [-3.0, -12.0]\n                - [3.0, -12.0]\n                - [6.0, -9.0]\n                - [7.0, -5.0]\n                - [4.0, 0.0]\n                - [-3.0, 0.0]\n                - [-6.0, -3.0]\n                - [-6.0, -8.0]\n              color: [30, 18, 27, 255]\n            r:\n              points: [[-4.0, -10.0], [4.0, -10.0], [6.0, -7.0], [4.0, -3.0], [-4.0, -2.0], [-6.0, -6.0]]\n              color: [30, 18, 27, 255]\n            sh:\n              points: [[-2.0, -10.0], [3.0, -10.0], [6.0, -7.0], [4.0, -2.0], [-3.0, -2.0], [-5.0, -6.0]]\n              color: [30, 18, 27, 255]\n            sibilant:\n              points: [[-7.0, -7.5], [7.0, -7.5], [6.0, -4.0], [-6.0, -4.0]]\n              color: [225, 210, 205, 255]\n            teeth_lip:\n              points: [[-6.0, -8.0], [6.0, -8.0], [5.0, -3.0], [-5.0, -3.0]]\n              color: [235, 225, 215, 255]\n            tongue_teeth:\n              points: [[-5.0, -8.0], [5.0, -8.0], [5.0, -3.0], [-5.0, -3.0]]\n              color: [210, 110, 120, 255]\n            tongue_up:\n              points: [[-5.0, -9.0], [5.0, -9.0], [6.0, -3.0], [-6.0, -3.0]]\n              color: [190, 90, 100, 255]\n            u:\n              points:\n                - [-2.0, -10.0]\n                - [2.0, -10.0]\n                - [4.0, -8.0]\n                - [4.0, -4.0]\n                - [2.0, -2.0]\n                - [-2.0, -2.0]\n                - [-4.0, -4.0]\n                - [-4.0, -8.0]\n              color: [30, 18, 27, 255]\n          smooth: 3\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.0\n        - id: beanie_crown\n          joint: head\n          points:\n            - [-26.0, -41.0]\n            - [26.0, -41.0]\n            - [29.0, -41.0]\n            - [28.0, -58.0]\n            - [16.0, -71.0]\n            - [-16.0, -71.0]\n            - [-28.0, -58.0]\n            - [-29.0, -41.0]\n          color: [210, 60, 70, 255]\n          smooth: 4\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.8\n            mode: behind\n        - id: beanie_band\n          joint: head\n          points:\n            - [-30.0, -46.0]\n            - [-27.0, -46.0]\n            - [27.0, -46.0]\n            - [30.0, -46.0]\n            - [30.0, -39.0]\n            - [27.0, -39.0]\n            - [-27.0, -39.0]\n            - [-30.0, -39.0]\n          color: [235, 225, 200, 255]\n          smooth: 4\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.6\n            mode: behind\n        - id: pompom\n          joint: head\n          color: [245, 245, 245, 255]\n          ellipse: {cx: 0.0, cy: -76.0, rx: 8.5, ry: 8.0}\n          outline:\n            color: [0, 0, 0, 255]\n            width: 1.6\n            mode: behind\n      visemes:\n        part: mouth\n        map:\n          a: a\n          closed: closed\n          e: e\n          i: i\n          o: o\n          r: r\n          sh: sh\n          sibilant: sibilant\n          teeth_lip: teeth_lip\n          tongue_teeth: tongue_teeth\n          tongue_up: tongue_up\n          u: u\n      expressions:\n        angry:\n          - {part: brow_l, variant: angry}\n          - {part: brow_r, variant: angry}\n        sad:\n          - {part: brow_l, variant: worried}\n          - {part: brow_r, variant: worried}\n        surprised:\n          - {part: brow_l, variant: raised}\n          - {part: brow_r, variant: raised}\n      eyes:\n        pupils: [pupil_l, pupil_r]\n        travel: 3.0\n        blink:\n          parts: [eye_l, eye_r, pupil_l, pupil_r]\n          variant: blink\n          interval: 2.2\n          duration: 0.14\n    voice: null\n\nscenes:\n  - composition:\n      transition: {type: cut}\n      background_color: '#241a3a'\n      background_keys: []\n      camera:\n        - {at: 0.0, x: 0.0, y: 40.0, zoom: 2.4}\n        - {at: 2.4, x: 0.0, y: 40.0, zoom: 2.544}\n      layers: {}\n      actor_tracks:\n        DAD:\n          - {at: 0.0, x: -1920.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0, easing: linear}\n        STAN:\n          - at: 0.0\n            x: 0.0\n            y: 48.00000000000003\n            rotation: 0.0\n            scale_x: 1.0\n            scale_y: 1.0\n            easing: linear\n      clip_weights: {}\n      clip_weight_tracks: {}\n      clip_instances: []\n      bone_tracks: {}\n      joint_tracks:\n        STAN:\n          head:\n            - {at: 0.0, x: 0.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0, easing: linear}\n            - {at: 1.2, x: 0.0, y: 0.0, rotation: 0.05, scale_x: 1.0, scale_y: 1.0, easing: linear}\n            - {at: 2.4, x: 0.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0, easing: linear}\n      gaze_tracks:\n        STAN:\n          - {at: 0.0, x: 333.0, y: 285.0}\n      fade_in: 0.0\n      fade_out: 0.0\n    background: null\n    id: bed_closeup\n    duration: 2.4\n    events:\n      - {type: emotion, at: 0.0, actor: STAN, value: sad}\n  - composition:\n      transition: {type: cut}\n      background_color: '#2e2242'\n      background_keys: []\n      camera:\n        - {at: 0.0, x: 0.0, y: 0.0, zoom: 1.0}\n      layers: {}\n      actor_tracks:\n        DAD:\n          - at: 0.0\n            x: 0.0\n            y: -29.99999999999997\n            rotation: 0.0\n            scale_x: 1.0\n            scale_y: 1.0\n            easing: linear\n        STAN:\n          - {at: 0.0, x: -1920.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0, easing: linear}\n      clip_weights: {}\n      clip_weight_tracks: {}\n      clip_instances: []\n      bone_tracks: {}\n      joint_tracks: {}\n      gaze_tracks:\n        DAD:\n          - {at: 0.0, x: 180.0, y: 290.0}\n      fade_in: 0.0\n      fade_out: 0.0\n    background: null\n    id: doorway_wide\n    duration: 4.05\n    events:\n      - {type: emotion, at: 0.0, actor: DAD, value: surprised}\n      - type: speak\n        at: 0.15\n        actor: DAD\n        text: Hey, kid. What are you doing? Are you playing a game?\n        emotion: null\n        audio: audio/dad_doorway.wav\n  - composition:\n      transition: {type: cut}\n      background_color: '#241a3a'\n      background_keys: []\n      camera:\n        - {at: 0.0, x: 0.0, y: 60.0, zoom: 1.5}\n        - {at: 2.95, x: 0.0, y: 60.0, zoom: 1.56}\n      layers: {}\n      actor_tracks:\n        DAD:\n          - {at: 0.0, x: -1920.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0, easing: linear}\n        STAN:\n          - at: 0.0\n            x: 0.0\n            y: 48.00000000000003\n            rotation: 0.0\n            scale_x: 1.0\n            scale_y: 1.0\n            easing: linear\n      clip_weights: {}\n      clip_weight_tracks: {}\n      clip_instances: []\n      bone_tracks: {}\n      joint_tracks: {}\n      gaze_tracks:\n        STAN:\n          - {at: 0.0, x: 333.0, y: 285.0}\n          - {at: 1.0, x: 333.0, y: 285.0}\n          - {at: 1.3, x: 500.0, y: 200.0}\n          - {at: 1.8, x: 333.0, y: 285.0}\n      fade_in: 0.0\n      fade_out: 0.0\n    background: null\n    id: boy_phone_medium\n    duration: 2.95\n    events:\n      - type: speak\n        at: 0.15\n        actor: STAN\n        text: No. I'm trying a face-editing app.\n        emotion: neutral\n        audio: audio/stan_phone.wav\n  - composition:\n      transition: {type: cut}\n      background_color: '#1c4a42'\n      background_keys: []\n      camera:\n        - {at: 0.0, x: 0.0, y: -30.0, zoom: 2.4}\n        - {at: 2.25, x: 0.0, y: -30.0, zoom: 2.544}\n      layers: {}\n      actor_tracks:\n        DAD:\n          - at: 0.0\n            x: 0.0\n            y: 8.000000000000028\n            rotation: 0.0\n            scale_x: 1.0\n            scale_y: 1.0\n            easing: linear\n        STAN:\n          - {at: 0.0, x: -1920.0, y: 0.0, rotation: 0.0, scale_x: 1.0, scale_y: 1.0, easing: linear}\n      clip_weights: {}\n      clip_weight_tracks: {}\n      clip_instances: []\n      bone_tracks: {}\n      joint_tracks: {}\n      gaze_tracks:\n        DAD:\n          - {at: 0.0, x: 150.0, y: 300.0}\n      fade_in: 0.0\n      fade_out: 0.0\n    background: null\n    id: dad_closeup\n    duration: 2.25\n    events:\n      - type: speak\n        at: 0.15\n        actor: DAD\n        text: Oh OK. Is that a game?\n        emotion: null\n        audio: audio/dad_closeup.wav\n",
