  "assets": [
    {
      "id": "kilsat_example",
      "kind": "image",
      "path": "assets/kilsat-example.png"
    }
  ],
  "format_version": 2,
  "source": "project:\n  title: Kilsat 14 – Autoton päivä autolla\n  width: 1920\n  height: 1080\n  fps: 24\n  captions:\n    enabled: true\n    font_size: 54\n    speaker_fill: {AINO: '#ffdf7c', RANE: '#ffffff'}\n    outline_width: 4\n    bottom_margin: 0.035\n    max_width: 0.9\n    line_height: 1.08\n    uppercase: false\n    background: '#17232b'\n\ncharacters:\n  AINO:\n    asset: characters/aino-original\n    default_pose: idle\n    rig:\n      version: 1\n      id: aino_original\n      joints:\n        - {id: root, parent: null}\n        - {id: torso, parent: root}\n        - {id: head, parent: torso, y: -144}\n        - {id: arm_l, parent: torso, x: -43, y: -103}\n        - {id: arm_r, parent: torso, x: 43, y: -103}\n      parts:\n        - id: leg_l\n          joint: root\n          points: [[-30, 15], [-4, 15], [-7, 116], [-29, 116]]\n          color: [52, 66, 81, 255]\n          smooth: 2\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: leg_r\n          joint: root\n          points: [[4, 15], [30, 15], [29, 116], [7, 116]]\n          color: [52, 66, 81, 255]\n          smooth: 2\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: shoe_l\n          joint: root\n          ellipse: {cx: -20, cy: 120, rx: 20, ry: 9}\n          color: [38, 41, 47, 255]\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: shoe_r\n          joint: root\n          ellipse: {cx: 20, cy: 120, rx: 20, ry: 9}\n          color: [38, 41, 47, 255]\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: torso\n          joint: torso\n          points: [[-30, -116], [30, -116], [45, -92], [43, 22], [-43, 22], [-45, -92]]\n          color: [42, 136, 132, 255]\n          smooth: 3\n          outline:\n            width: 2.4\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: collar\n          joint: torso\n          points: [[-16, -116], [16, -116], [0, -92]]\n          color: [231, 224, 208, 255]\n          smooth: 2\n          outline:\n            width: 1.3\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: sleeve_l\n          joint: arm_l\n          points: [[-11, -3], [11, -3], [10, 66], [-10, 66]]\n          color: [42, 136, 132, 255]\n          smooth: 3\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hand_l\n          joint: arm_l\n          ellipse: {cx: 0, cy: 72, rx: 10, ry: 12}\n          color: [233, 184, 151, 255]\n          outline:\n            width: 1.8\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: sleeve_r\n          joint: arm_r\n          points: [[-11, -3], [11, -3], [10, 66], [-10, 66]]\n          color: [42, 136, 132, 255]\n          smooth: 3\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hand_r\n          joint: arm_r\n          ellipse: {cx: 0, cy: 72, rx: 10, ry: 12}\n          color: [233, 184, 151, 255]\n          outline:\n            width: 1.8\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hair_back\n          joint: head\n          ellipse: {cx: 0, cy: -25, rx: 40, ry: 46}\n          color: [74, 45, 43, 255]\n          outline:\n            width: 2.2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: face\n          joint: head\n          ellipse: {cx: 0, cy: -24, rx: 31, ry: 37}\n          color: [233, 184, 151, 255]\n          outline:\n            width: 2.2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hair_top\n          joint: head\n          points:\n            - [-32, -39]\n            - [-28, -57]\n            - [-12, -69]\n            - [12, -65]\n            - [29, -51]\n            - [32, -37]\n            - [12, -50]\n            - [-7, -47]\n            - [-20, -35]\n          color: [74, 45, 43, 255]\n          smooth: 3\n          outline:\n            width: 1.8\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: eye_l\n          joint: head\n          ellipse: {cx: -13, cy: -27, rx: 8.5, ry: 10}\n          color: [249, 250, 249, 255]\n          outline:\n            width: 1.2\n            mode: behind\n            color: [27, 28, 36, 255]\n          variants:\n            blink:\n              ellipse: {cx: -13, cy: -27, rx: 8.5, ry: 1.1}\n              color: [233, 184, 151, 255]\n        - id: pupil_l\n          joint: head\n          ellipse: {cx: -13, cy: -26, rx: 3.6, ry: 4.6}\n          color: [36, 40, 47, 255]\n          outline:\n            width: 0\n            mode: behind\n            color: [27, 28, 36, 255]\n          variants:\n            blink:\n              color: [0, 0, 0, 0]\n        - id: brow_l\n          joint: head\n          points: [[-22, -44], [-4, -44], [-4, -40], [-22, -40]]\n          color: [74, 45, 43, 255]\n          smooth: 2\n          outline:\n            width: 0\n            mode: behind\n            color: [27, 28, 36, 255]\n          variants:\n            raised:\n              points: [[-22, -52], [-4, -52], [-4, -48], [-22, -48]]\n            worried:\n              points: [[-22, -44], [-4, -50], [-4, -46], [-22, -40]]\n            angry:\n              points: [[-22, -47], [-4, -39], [-4, -35], [-22, -43]]\n        - id: eye_r\n          joint: head\n          ellipse: {cx: 13, cy: -27, rx: 8.5, ry: 10}\n          color: [249, 250, 249, 255]\n          outline:\n            width: 1.2\n            mode: behind\n            color: [27, 28, 36, 255]\n          variants:\n            blink:\n              ellipse: {cx: 13, cy: -27, rx: 8.5, ry: 1.1}\n              color: [233, 184, 151, 255]\n        - id: pupil_r\n          joint: head\n          ellipse: {cx: 13, cy: -26, rx: 3.6, ry: 4.6}\n          color: [36, 40, 47, 255]\n          outline:\n            width: 0\n            mode: behind\n            color: [27, 28, 36, 255]\n          variants:\n            blink:\n              color: [0, 0, 0, 0]\n        - id: brow_r\n          joint: head\n          points: [[4, -44], [22, -44], [22, -40], [4, -40]]\n          color: [74, 45, 43, 255]\n          smooth: 2\n          outline:\n            width: 0\n            mode: behind\n            color: [27, 28, 36, 255]\n          variants:\n            raised:\n              points: [[4, -52], [22, -52], [22, -48], [4, -48]]\n            worried:\n              points: [[4, -44], [22, -50], [22, -46], [4, -40]]\n            angry:\n              points: [[4, -39], [22, -47], [22, -43], [4, -35]]\n        - id: nose\n          joint: head\n          points: [[0, -24], [-4, -9], [5, -9]]\n          color: [233, 184, 151, 255]\n          smooth: 2\n          outline:\n            width: 1\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: mouth\n          joint: head\n          ellipse: {cx: 0, cy: 3, rx: 10, ry: 1.7}\n          color: [86, 36, 43, 255]\n          outline:\n            width: 1.1\n            mode: behind\n            color: [27, 28, 36, 255]\n          variants:\n            closed:\n              ellipse: {cx: 0, cy: 5, rx: 11, ry: 1.4}\n            teeth_lip:\n              ellipse: {cx: 0, cy: 5, rx: 9, ry: 3}\n              color: [247, 239, 225, 255]\n            tongue_teeth:\n              ellipse: {cx: 0, cy: 5, rx: 9, ry: 5}\n            tongue_up:\n              ellipse: {cx: 0, cy: 5, rx: 11, ry: 6}\n            sibilant:\n              ellipse: {cx: 0, cy: 5, rx: 12, ry: 3}\n            sh:\n              ellipse: {cx: 0, cy: 5, rx: 9, ry: 6}\n            r:\n              ellipse: {cx: 0, cy: 5, rx: 9, ry: 6}\n            a:\n              ellipse: {cx: 0, cy: 5, rx: 11, ry: 11}\n            e:\n              ellipse: {cx: 0, cy: 5, rx: 13, ry: 5}\n            i:\n              ellipse: {cx: 0, cy: 5, rx: 14, ry: 3}\n            o:\n              ellipse: {cx: 0, cy: 5, rx: 7, ry: 10}\n            u:\n              ellipse: {cx: 0, cy: 5, rx: 5, ry: 7}\n      visemes:\n        part: mouth\n        map:\n          closed: closed\n          teeth_lip: teeth_lip\n          tongue_teeth: tongue_teeth\n          tongue_up: tongue_up\n          sibilant: sibilant\n          sh: sh\n          r: r\n          a: a\n          e: e\n          i: i\n          o: o\n          u: u\n      expressions:\n        happy:\n          - {part: brow_l, variant: raised}\n          - {part: brow_r, variant: raised}\n        sad:\n          - {part: brow_l, variant: worried}\n          - {part: brow_r, variant: worried}\n        surprised:\n          - {part: brow_l, variant: raised}\n          - {part: brow_r, variant: raised}\n        angry:\n          - {part: brow_l, variant: angry}\n          - {part: brow_r, variant: angry}\n      eyes:\n        pupils: [pupil_l, pupil_r]\n        travel: 3.0\n        blink:\n          parts: [eye_l, eye_r, pupil_l, pupil_r]\n          variant: blink\n          interval: 3.4\n          duration: 0.13\n    voice: {provider: piper, preset: piper_harri, language: fi-fi, speed: 1.0}\n  RANE:\n    asset: characters/rane-original\n    default_pose: idle\n    rig:\n      version: 1\n      id: rane_original\n      joints:\n        - {id: root, parent: null}\n        - {id: torso, parent: root}\n        - {id: head, parent: torso, y: -144}\n        - {id: arm_l, parent: torso, x: -43, y: -103}\n        - {id: arm_r, parent: torso, x: 43, y: -103}\n      parts:\n        - id: leg_l\n          joint: root\n          points: [[-30, 15], [-4, 15], [-7, 116], [-29, 116]]\n          color: [52, 66, 81, 255]\n          smooth: 2\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: leg_r\n          joint: root\n          points: [[4, 15], [30, 15], [29, 116], [7, 116]]\n          color: [52, 66, 81, 255]\n          smooth: 2\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: shoe_l\n          joint: root\n          ellipse: {cx: -20, cy: 120, rx: 20, ry: 9}\n          color: [38, 41, 47, 255]\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: shoe_r\n          joint: root\n          ellipse: {cx: 20, cy: 120, rx: 20, ry: 9}\n          color: [38, 41, 47, 255]\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: torso\n          joint: torso\n          points: [[-30, -116], [30, -116], [45, -92], [43, 22], [-43, 22], [-45, -92]]\n          color: [137, 83, 58, 255]\n          smooth: 3\n          outline:\n            width: 2.4\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: collar\n          joint: torso\n          points: [[-16, -116], [16, -116], [0, -92]]\n          color: [231, 224, 208, 255]\n          smooth: 2\n          outline:\n            width: 1.3\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: sleeve_l\n          joint: arm_l\n          points: [[-11, -3], [11, -3], [10, 66], [-10, 66]]\n          color: [137, 83, 58, 255]\n          smooth: 3\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hand_l\n          joint: arm_l\n          ellipse: {cx: 0, cy: 72, rx: 10, ry: 12}\n          color: [202, 149, 118, 255]\n          outline:\n            width: 1.8\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: sleeve_r\n          joint: arm_r\n          points: [[-11, -3], [11, -3], [10, 66], [-10, 66]]\n          color: [137, 83, 58, 255]\n          smooth: 3\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hand_r\n          joint: arm_r\n          ellipse: {cx: 0, cy: 72, rx: 10, ry: 12}\n          color: [202, 149, 118, 255]\n          outline:\n            width: 1.8\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: face\n          joint: head\n          ellipse: {cx: 0, cy: -24, rx: 34, ry: 40}\n          color: [202, 149, 118, 255]\n          outline:\n            width: 2.2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hair_top\n          joint: head\n          points:\n            - [-32, -39]\n            - [-28, -57]\n            - [-12, -69]\n            - [12, -65]\n            - [29, -51]\n            - [32, -37]\n            - [12, -50]\n            - [-7, -47]\n            - [-20, -35]\n          color: [61, 56, 63, 255]\n          smooth: 3\n          outline:\n            width: 1.8\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: eye_l\n          joint: head\n          ellipse: {cx: -13, cy: -27, rx: 8.5, ry: 10}\n          color: [249, 250, 249, 255]\n          outline:\n            width: 1.2\n            mode: behind\n            color: [27, 28, 36, 255]\n          variants:\n            blink:\n              ellipse: {cx: -13, cy: -27, rx: 8.5, ry: 1.1}\n              color: [202, 149, 118, 255]\n        - id: pupil_l\n          joint: head\n          ellipse: {cx: -13, cy: -26, rx: 3.6, ry: 4.6}\n          color: [36, 40, 47, 255]\n          outline:\n            width: 0\n            mode: behind\n            color: [27, 28, 36, 255]\n          variants:\n            blink:\n              color: [0, 0, 0, 0]\n        - id: brow_l\n          joint: head\n          points: [[-22, -44], [-4, -39], [-4, -35], [-22, -40]]\n          color: [61, 56, 63, 255]\n          smooth: 2\n          outline:\n            width: