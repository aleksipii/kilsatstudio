_r, variant: raised}\n        angry:\n          - {part: brow_l, variant: angry}\n          - {part: brow_r, variant: angry}\n      eyes:\n        pupils: [pupil_l, pupil_r]\n        travel: 3.0\n        blink:\n          parts: [eye_l, eye_r, pupil_l, pupil_r]\n          variant: blink\n          interval: 4.1\n          duration: 0.13\n    voice: {provider: piper, preset: piper_harri, language: fi-fi, speed: 0.93}\n\nscenes:\n  - id: e14_line01\n    duration: 4.0\n    background: toimisto\n    composition:\n      background_color: '#e6e1d6'\n      camera:\n        - {at: 0, x: 0, y: -75, zoom: 1.0}\n        - {at: 4.0, x: 0, y: -75, zoom: 1.018}\n      layers:\n        AINO: {z: 0, visible: true}\n        RANE: {z: 1, visible: true}\n      actor_tracks:\n        AINO:\n          - {at: 0, x: -350, y: 44, scale_x: 2.2, scale_y: 2.2}\n        RANE:\n          - {at: 0, x: 350, y: 44, scale_x: 2.2, scale_y: 2.2}\n      joint_tracks:\n        AINO:\n          head:\n            - {at: 0}\n            - {at: 0.28, rotation: 0.045}\n            - {at: 0.75, rotation: -0.025}\n            - {at: 4.0, rotation: 0}\n          arm_l:\n            - {at: 0}\n            - {at: 0.45, rotation: 0.19}\n            - {at: 4.0, rotation: 0}\n        RANE:\n          head:\n            - {at: 0}\n            - {at: 0.28, rotation: 0.025}\n            - {at: 0.75, rotation: -0.035}\n            - {at: 4.0, rotation: 0}\n          arm_r:\n            - {at: 0}\n            - {at: 0.45, rotation: -0.03}\n            - {at: 4.0, rotation: 0}\n      gaze_tracks:\n        AINO:\n          - {at: 0, target: RANE}\n        RANE:\n          - {at: 0, target: AINO}\n    events:\n      - {type: emotion, at: 0, actor: AINO, value: happy}\n      - type: speak\n        at: 0.35\n        actor: AINO\n        text: Tänään on meidän autoton työpäivämme.\n        emotion: happy\n        audio: null\n  - id: e14_line02\n    duration: 4.1\n    background: toimisto\n    composition:\n      background_