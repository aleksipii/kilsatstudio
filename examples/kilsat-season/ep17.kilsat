  "format_version": 2,
  "source": "{\"project\":{\"title\":\"Kilsat 17 – Passiivinen ajopäiväkirja\",\"width\":1920,\"height\":1080,\"fps\":24,\"captions\":{\"enabled\":true,\"font_size\":54,\"speaker_fill\":{\"AINO\":\"#ffdf7c\",\"RANE\":\"#ffffff\"},\"outline_width\":4,\"bottom_margin\":0.035,\"max_width\":0.9,\"line_height\":1.08,\"uppercase\":false,\"background\":\"#17232b\"}},\"characters\":{\"AINO\":{\"asset\":\"characters/aino-original\",\"default_pose\":\"idle\",\"rig\":{\"version\":1,\"id\":\"aino_original\",\"joints\":[{\"id\":\"root\",\"parent\":null},{\"id\":\"torso\",\"parent\":\"root\"},{\"id\":\"head\",\"parent\":\"torso\",\"y\":-144},{\"id\":\"arm_l\",\"parent\":\"torso\",\"x\":-43,\"y\":-103},{\"id\":\"arm_r\",\"parent\":\"torso\",\"x\":43,\"y\":-103}],\"parts\":[{\"id\":\"leg_l\",\"joint\":\"root\",\"points\":[[-30,15],[-4,15],[-7,116],[-29,116]],\"color\":[52,66,81,255],\"smooth\":2,\"outline\":{\"width\":2,\"mode\":\"behind\",\"color\":[27,28,36,255]}},{\"id\":\"leg_r\",\"joint\":\"root\",\"points\":[[4,15],[30,15],[29,116],[7,116]],\"color\":[52,66,81,255],\"smooth\":2,\"outline\":{\"width\":2,\"mode\":\"behind\",\"color\":[27,28,36,255]}},{\"id\":\"shoe_l\",\"joint\":\"root\",\"ellipse\":{\"cx\":-20,\"cy\":120,\"rx\":20,\"ry\":9},\"color\":[38,41,47,255],\"outline\":{\"width\":2,\"mode\":\"behind\",\"color\":[27,28,36,255]}},{\"id\":\"shoe_r\",\"joint\":\"root\",\"ellipse\":{\"cx\":20,\"cy\":120,\"rx\":20,\"ry\":9},\"color\":[38,41,47,255],\"outline\":{\"width\":2,\"mode\":\"behind\",\"color\":[27,28,36,255]}},{\"id\":\"torso\",\"joint\":\"torso\",\"points\":[[-30,-116],[30,-116],[45,-92],[43,22],[-43,22],[-45,-92]],\"color\":[42,136,132,255],\"smooth\":3,\"outline\":{\"width\":2.4,\"mode\":\"behind\",\"color\":[27,28,36,255]}},{\"id\":\"collar\",\"joint\":\"torso\",\"points\":[[-16,-116],[16,-116],[0,-92]],\"color\":[231,224,208,255],\"smooth\":2,\"outline\":{\"width\":1.3,\"mode\":\"behind\",\"color\":[27,28,36,255]}},{\"id\":\"sleeve_l\",\"joint\":\"arm_l\",\"poi