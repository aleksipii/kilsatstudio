 - id: pupil_r\n          joint: head\n          ellipse: {cx: 16, cy: -2, rx: 3.1, ry: 4.2}\n          color: [36, 40, 45, 255]\n          variants:\n            blink:\n              color: [0, 0, 0, 0]\n        - id: brow_r\n          joint: head\n          points: [[7, -21], [25, -21], [25, -18], [7, -18]]\n          color: [36, 40, 45, 255]\n          smooth: 2\n          variants:\n            happy:\n              points: [[7, -25], [16, -28], [25, -25], [25, -22], [16, -25], [7, -22]]\n            raised:\n              points: [[7, -31], [25, -31], [25, -28], [7, -28]]\n            worried:\n              points: [[7, -27], [25, -20], [25, -17], [7, -24]]\n            angry:\n              points: [[7, -19], [25, -27], [25, -24], [7, -16]]\n        - id: mouth\n          joint: head\n          ellipse: {cx: 0, cy: 19, rx: 10, ry: 1.6}\n          color: [36, 40, 45, 255]\n          variants:\n            rest:\n              ellipse: {cx: 0, cy: 19, rx: 10, ry: 1.6}\n            closed:\n              ellipse: {cx: 0, cy: 19, rx: 10, ry: 0.9}\n            teeth_lip:\n              ellipse: {cx: 0, cy: 19, rx: 9, ry: 3}\n              color: [249, 247, 239, 255]\n              outline:\n                color: [36, 40, 45, 255]\n                width: 1.6\n                mode: behind\n            tongue_teeth:\n              ellipse: {cx: 0, cy: 19, rx: 9, ry: 5}\n            tongue_up:\n              ellipse: {cx: 0, cy: 19, rx: 11, ry: 6}\n            sibilant:\n              ellipse: {cx: 0, cy: 19, rx: 12, ry: 2.5}\n            sh:\n              ellipse: {cx: 0, cy: 19, rx: 8, ry: 6}\n            r:\n              ellipse: {cx: 0, cy: 19, rx: 9, ry: 7}\n            a:\n              ellipse: {cx: 0, cy: 19, rx: 11, ry: 11}\n            e:\n              ellipse: {cx: 0, cy: 19, rx: 13, ry: 5}\n            i:\n              ellipse: {cx: 0, cy: 19, rx: 14, ry: 3}\n            o:\n              ellipse: {cx: 0, cy: 19, rx: 7, ry: 10}\n            u:\n              ellipse: {cx: 0, cy: 19, rx: 5, ry: 7}\n            smile:\n              points: [[-12, 15], [-6, 19], [0, 20], [6, 19], [12, 15], [7, 22], [0, 24], [-7, 22]]\n              smooth: 2\n            frown:\n              points: [[-11, 23], [-6, 19], [0, 18], [6, 19], [11, 23], [6, 22], [0, 21], [-6, 22]]\n              smooth: 2\n        - id: beanie_crown\n          joint: head\n          ellipse: {cx: 0, cy: -40, rx: 43, ry: 21}\n          color: [206, 138, 71, 255]\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1.6\n            mode: behind\n        - id: beanie_band\n          joint: head\n          points: [[-44, -35], [44, -35], [43, -22], [-43, -22]]\n          color: [206, 138, 71, 255]\n          smooth: 2\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1.5\n            mode: behind\n        - id: goggle_l\n          joint: head\n          ellipse: {cx: -15, cy: -29, rx: 11, ry: 9}\n          color: [177, 199, 202, 255]\n          outline:\n            color: [36, 40, 45, 255]\n            width: 2\n            mode: behind\n          views:\n            three_quarter:\n              ellipse: {cx: -7.0, cy: -29, rx: 8.8, ry: 9}\n            side:\n              ellipse: {cx: 3.0, cy: -29, rx: 6.1, ry: 9}\n            back:\n              color: [0, 0, 0, 0]\n        - id: goggle_r\n          joint: head\n          ellipse: {cx: 15, cy: -29, rx: 11, ry: 9}\n          color: [177, 199, 202, 255]\n          outline:\n            color: [36, 40, 45, 255]\n            width: 2\n            mode: behind\n          views:\n            three_quarter:\n              ellipse: {cx: 17.0, cy: -29, rx: 8.8, ry: 9}\n            side:\n              ellipse: {cx: 19.5, cy: -29, rx: 6.1, ry: 9}\n            back:\n              color: [0, 0, 0, 0]\n        - id: goggle_bridge\n          joint: head\n          points: [[-5, -31], [5, -31], [5, -27], [-5, -27]]\n          color: [89, 95, 101, 255]\n          smooth: 2\n          views:\n            three_quarter:\n              points: [[1.0, -31], [9.0, -31], [9.0, -27], [1.0, -27]]\n            side:\n              points: [[8.5, -31], [14.0, -31], [14.0, -27], [8.5, -27]]\n            back:\n              points: [[-44, -32], [44, -32], [44, -26], [-44, -26]]\n      visemes:\n        part: mouth\n        map:\n          rest: rest\n          closed: closed\n          teeth_lip: teeth_lip\n          tongue_teeth: tongue_teeth\n          tongue_up: tongue_up\n          sibilant: sibilant\n          sh: sh\n          r: r\n          a: a\n          e: e\n          i: i\n          o: o\n          u: u\n      expressions:\n        happy:\n          - {part: brow_l, variant: happy}\n          - {part: brow_r, variant: happy}\n          - {part: mouth, variant: smile}\n        sad:\n          - {part: brow_l, variant: worried}\n          - {part: brow_r, variant: worried}\n          - {part: mouth, variant: frown}\n        surprised:\n          - {part: brow_l, variant: raised}\n          - {part: brow_r, variant: raised}\n          - {part: mouth, variant: o}\n        angry:\n          - {part: brow_l, variant: angry}\n          - {part: brow_r, variant: angry}\n          - {part: mouth, variant: closed}\n      hands:\n        left:\n          part: hand_l\n          shapes: {fist: fist, open: open, point: point, grip: grip, thumbs_up: thumbs_up}\n        right:\n          part: hand_r\n          shapes: {fist: fist, open: open, point: point, grip: grip, thumbs_up: thumbs_up}\n      eyes:\n        pupils: [pupil_l, pupil_r]\n        travel: 3.4\n        blink:\n          parts: [eye_l, eye_r, pupil_l, pupil_r]\n          variant: blink\n          interval: 3.91\n          duration: 0.12\n    voice: {provider: piper, preset: piper_harri, language: fi-fi, speed: 1.0}\n    acting: lively\n\nscenes:\n  - id: hahmo\n    duration: 5\n    composition:\n      background_color: '#f4f1e9'\n      camera:\n        - {at: 0, x: 0, y: 0, zoom: 1}\n      layers:\n        KIPINA: {z: 0, visible: true}\n      actor_tracks:\n        KIPINA:\n          - {at: 0, easing: smoothstep, x: 0.0, y: -20, scale_x: 1.8, scale_y: 1.8}\n      joint_tracks:\n        KIPINA:\n          head:\n            - {at: 0, easing: smoothstep}\n            - {at: 1.5, easing: smoothstep, rotation: -0.05}\n            - {at: 5, easing: smoothstep}\n    events: []\n\nrig_clips:\n  odotus:\n    duration: 4\n    joint_tracks:\n      head:\n        - {at: 0, easing: smoothstep}\n        - {at: 2, easing: smoothstep, rotation: 0.035}\n        - {at: 4, easing: smoothstep}\n      torso:\n        - {at: 0, easing: smoothstep}\n        - {at: 2, easing: smoothstep, y: -2}\n        - {at: 4, easing: smoothstep}\n  vilkutus:\n    duration: 4\n    joint_tracks:\n      upper_arm_l:\n        - {at: 0, easing: smoothstep}\n        - {at: 0.6, easing: smoothstep, rotation: 2.3}\n        - {at: 3, easing: smoothstep, rotation: 2.3}\n        - {at: 4, easing: smoothstep}\n      forearm_l:\n        - {at: 0, easing: smoothstep}\n        - {at: 0.6, easing: smoothstep, rotation: -0.7}\n        - {at: 1.2, easing: smoothstep, rotation: -0.3}\n        - {at: 1.8, easing: smoothstep, rotation: -0.9}\n        - {at: 2.4, easing: smoothstep, rotation: -0.3}\n        - {at: 3, easing: smoothstep, rotation: -0.7}\n        - {at: 4, easing: smoothstep}\n  osoitus:\n    duration: 4\n    joint_tracks:\n      upper_arm_l:\n        - {at: 0, easing: smoothstep}\n        - {at: 1, easing: smoothstep, rotation: 1.55}\n        - {at: 3, easing: smoothstep, rotation: 1.55}\n        - {at: 4, easing: smoothstep}\n      head:\n        - {at: 0, easing: smoothstep}\n        - {at: 1, easing: smoothstep, rotation: -0.08}\n        - {at: 4, easing: smoothstep}\n  reaktio:\n    duration: 4\n    joint_tracks:\n      head:\n        - {at: 0, easing: smoothstep}\n        - {at: 0.35, easing: smoothstep, rotation: -0.16, y: -4}\n        - {at: 1, easing: smoothstep, rotation: 0.06}\n        - {at: 4, easing: smoothstep}\n      torso:\n        - {at: 0, easing: smoothstep}\n        - {at: 0.35, easing: smoothstep, rotation: 0.06}\n        - {at: 4, easing: smoothstep}\n  askel:\n    duration: 1.2\n    joint_tracks:\n      thigh_l:\n        - {at: 0, easing: smoothstep, rotation: -0.22}\n        - {at: 0.6, easing: smoothstep, rotation: 0.22}\n        - {at: 1.2, easing: smoothstep, rotation: -0.22}\n      thigh_r:\n        - {at: 0, easing: smoothstep, rotation: 0.22}\n        - {at: 0.6, easing: smoothstep, rotation: -0.22}\n        - {at: 1.2, easing: smoothstep, rotation: 0.22}\n      shin_l:\n        - {at: 0, easing: smoothstep}\n        - {at: 0.6, easing: smoothstep, rotation: -0.18}\n        - {at: 1.2, easing: smoothstep}\n      shin_r:\n        - {at: 0, easing: smoothstep, rotation: -0.18}\n        - {at: 0.6, easing: smoothstep}\n        - {at: 1.2, easing: smoothstep, rotation: -0.18}\n",
