cy: 19, rx: 11, ry: 6}\n            sibilant:\n              ellipse: {cx: 0, cy: 19, rx: 12, ry: 2.5}\n            sh:\n              ellipse: {cx: 0, cy: 19, rx: 8, ry: 6}\n            r:\n              ellipse: {cx: 0, cy: 19, rx: 9, ry: 7}\n            a:\n              ellipse: {cx: 0, cy: 19, rx: 11, ry: 11}\n            e:\n              ellipse: {cx: 0, cy: 19, rx: 13, ry: 5}\n            i:\n              ellipse: {cx: 0, cy: 19, rx: 14, ry: 3}\n            o:\n              ellipse: {cx: 0, cy: 19, rx: 7, ry: 10}\n            u:\n              ellipse: {cx: 0, cy: 19, rx: 5, ry: 7}\n            smile:\n              points: [[-12, 15], [-6, 19], [0, 20], [6, 19], [12, 15], [7, 22], [0, 24], [-7, 22]]\n              smooth: 2\n            frown:\n              points: [[-11, 23], [-6, 19], [0, 18], [6, 19], [11, 23], [6, 22], [0, 21], [-6, 22]]\n              smooth: 2\n        - id: cap_crown\n          joint: head\n          ellipse: {cx: -2, cy: -36, rx: 43, ry: 19}\n          color: [94, 145, 174, 255]\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1.8\n            mode: behind\n        - id: cap_brim\n          joint: head\n          points: [[-43, -34], [28, -34], [52, -25], [48, -20], [-40, -23]]\n          color: [94, 145, 174, 255]\n          smooth: 2\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1.4\n            mode: behind\n          views:\n            three_quarter:\n              points: [[-40, -34], [28, -34], [58.3, -25], [54.3, -20], [-37, -23]]\n            side:\n              points: [[-34, -34], [28, -34], [66, -25], [62, -20], [-31, -23]]\n            back:\n              color: [0, 0, 0, 0]\n        - id: heldprop_r_puhelin_case\n          joint: hand_r\n          points: [[-7, -54], [23, -54], [26, -51], [26, 11], [23, 14], [-7, 14], [-10, 11], [-10, -51]]\n          color: [36, 40, 45, 255]\n        - id: heldprop_r_puhelin_rim\n          joint: hand_r\n          point