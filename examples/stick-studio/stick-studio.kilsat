  "source": "project: {title: Tikku-ukkostudio 2 – esineet ja kuvakoot, width: 1920, height: 1080, fps: 24}\n\ncharacters:\n  NOUTAJA:\n    asset: characters/noutaja-stick-original\n    default_pose: idle\n    rig:\n      version: 1\n      id: noutaja_stick_original\n      joints:\n        - {id: root, parent: null}\n        - {id: torso, parent: root, y: -85}\n        - {id: head, parent: torso, y: -110}\n        - {id: upper_arm_l, parent: torso, x: -43, y: -65, rotation: 0.16}\n        - {id: forearm_l, parent: upper_arm_l, y: 58}\n        - {id: hand_l, parent: forearm_l, y: 54}\n        - {id: upper_arm_r, parent: torso, x: 43, y: -65, rotation: -0.16}\n        - {id: forearm_r, parent: upper_arm_r, y: 58}\n        - {id: hand_r, parent: forearm_r, y: 54}\n        - {id: thigh_l, parent: root, x: -13, rotation: 0.055}\n        - {id: shin_l, parent: thigh_l, y: 70}\n        - {id: foot_l, parent: shin_l, y: 62}\n        - {id: thigh_r, parent: root, x: 13, rotation: -0.055}\n        - {id: shin_r, parent: thigh_r, y: 70}\n        - {id: foot_r, parent: shin_r, y: 62}\n      parts:\n        - id: thigh_l\n          joint: thigh_l\n          points:\n            - [-4.5, 0.0]\n            - [-3.8971, -2.25]\n            - [-2.25, -3.8971]\n            - [-0.0, -4.5]\n            - [2.25, -3.8971]\n            - [3.8971, -2.25]\n            - [4.5, -0.0]\n            - [4.5, 70.0]\n            - [3.8971, 72.25]\n            - [2.25, 73.8971]\n            - [0.0, 74.5]\n            - [-2.25, 73.8971]\n            - [-3.8971, 72.25]\n            - [-4.5, 70.0]\n          color: [36, 40, 45, 255]\n        - id: shin_l\n          joint: shin_l\n          points:\n            - [-4.0, 0.0]\n            - [-3.4641, -2.0]\n            - [-2.0, -3.4641]\n            - [-0.0, -4.0]\n            - [2.0, -3.4641]\n            - [3.4641, -2.0]\n            - [4.0, -0.0]\n            - [4.0, 62.0]\n            - [3.4641, 64.0]\n            - [2.0, 65.4641]\n            - [0.0,