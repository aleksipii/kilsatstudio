      ellipse: {cx: 6, cy: 3, rx: 8, ry: 2.4}\n          color: [36, 40, 45, 255]\n        - id: heldprop_r_puhelin_thumb\n          joint: hand_r\n          ellipse: {cx: -2, cy: -1, rx: 3.8, ry: 6}\n          color: [36, 40, 45, 255]\n      visemes:\n        part: mouth\n        map:\n          rest: rest\n          closed: closed\n          teeth_lip: teeth_lip\n          tongue_teeth: tongue_teeth\n          tongue_up: tongue_up\n          sibilant: sibilant\n          sh: sh\n          r: r\n          a: a\n          e: e\n          i: i\n          o: o\n          u: u\n      expressions:\n        happy:\n          - {part: brow_l, variant: happy}\n          - {part: brow_r, variant: happy}\n          - {part: mouth, variant: smile}\n        sad:\n          - {part: brow_l, variant: worried}\n          - {part: brow_r, variant: worried}\n          - {part: mouth, variant: frown}\n        surprised:\n          - {part: brow_l, variant: raised}\n          - {part: brow_r, variant: raised}\n          - {part: mouth, variant: o}\n        angry:\n          - {part: brow_l, variant: angry}\n          - {part: brow_r, variant: angry}\n          - {part: mouth, variant: closed}\n      hands:\n        left:\n          part: hand_l\n          shapes: {fist: fist, open: open, point: point, grip: grip, thumbs_up: thumbs_up}\n        right:\n          part: hand_r\n          shapes: {fist: fist, open: open, point: point, grip: grip, thumbs_up: thumbs_up}\n      eyes:\n        pupils: [pupil_l, pupil_r]\n        travel: 3.4\n        blink:\n          parts: [eye_l, eye_r, pupil_l, pupil_r]\n          variant: blink\n          interval: 3.57\n          duration: 0.12\n      screens:\n        - id: phone\n          part: heldprop_r_puhelin_screen\n          origin: [-6, -45]\n          x_axis: [28, 0]\n          y_axis: [0, 51]\n          overlays: [heldprop_r_puhelin_message, heldprop_r_puhelin_reply, heldprop_r_puhelin_call]\n    voice: {provider: piper, preset: piper_harri,