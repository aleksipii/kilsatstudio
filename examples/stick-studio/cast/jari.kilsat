n        - id: hair_side_l\n          joint: head\n          points: [[-43, -8], [-38, -20], [-32, -12], [-34, 4]]\n          color: [107, 74, 54, 255]\n          smooth: 2\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1\n            mode: behind\n          views:\n            side:\n              points: [[-20.7, -8], [-16.2, -20], [-10.8, -12], [-12.6, 4]]\n        - id: hair_side_r\n          joint: head\n          points: [[43, -8], [38, -20], [32, -12], [34, 4]]\n          color: [107, 74, 54, 255]\n          smooth: 2\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1\n            mode: behind\n          views:\n            side:\n              color: [0, 0, 0, 0]\n        - id: cap_crown\n          joint: head\n          ellipse: {cx: -2, cy: -36, rx: 43, ry: 19}\n          color: [78, 110, 126, 255]\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1.6\n            mode: behind\n        - id: cap_brim\n          joint: head\n          points: [[-43, -34], [28, -34], [52, -25], [48, -20], [-40, -23]]\n          color: [58, 82, 94, 255]\n          smooth: 2\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1.3\n            mode: behind\n          views:\n            three_quarter:\n              points: [[-40, -34], [28, -34], [58.3, -25], [54.3, -20], [-37, -23]]\n            side:\n              points: [[-34, -34], [28, -34], [66, -25], [62, -20], [-31, -23]]\n            back:\n              color: [0, 0, 0, 0]\n      visemes:\n        part: mouth\n        map:\n          rest: rest\n          closed: closed\n          teeth_lip: teeth_lip\n          tongue_teeth: tongue_teeth\n          tongue_up: tongue_up\n          sibilant: sibilant\n          sh: sh\n          r: r\n          a: a\n          e: e\n          i: i\n          o: o\n          u: u\n      expressions:\n        happy:\n          - {part: brow_l, variant: happy}\n          - 