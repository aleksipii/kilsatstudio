il_r]\n          variant: blink\n          interval: 4.14\n          duration: 0.12\n    acting: proud\n\nscenes:\n  - id: hahmo\n    duration: 5\n    events: []\n    composition:\n      background_color: '#f4f1e9'\n      camera:\n        - {at: 0, x: 0, y: 0, zoom: 1}\n      layers:\n        ANKKURI: {z: 0, visible: true}\n      actor_tracks:\n        ANKKURI:\n          - {at: 0, easing: smoothstep, x: 0.0, y: -20, scale_x: 1.8, scale_y: 1.8}\n      joint_tracks:\n        ANKKURI:\n          head:\n            - {at: 0, easing: smoothstep}\n            - {at: 1.5, easing: smoothstep, rotation: -0.05}\n            - {at: 5, easing: smoothstep}\n\nrig_clips:\n  odotus:\n    duration: 4\n    joint_tracks:\n      head:\n        - {at: 0, easing: smoothstep}\n        - {at: 2, easing: smoothstep, rotation: 0.035}\n        - {at: 4, easing: smoothstep}\n      torso:\n        - {at: 0, easing: smoothstep}\n        - {at: 2, easing: smoothstep, y: -2}\n        - {at: 4, easing: smoothstep}\n  vilkutus:\n    duration: 4\n    joint_tracks:\n      upper_arm_l:\n        - {at: 0, easing: smoothstep}\n        - {at: 0.6, easing: smoothstep, rotation: 2.3}\n        - {at: 3, easing: smoothstep, rotation: 2.3}\n        - {at: 4, easing: smoothstep}\n      forearm_l:\n        - {at: 0, easing: smoothstep}\n        - {at: 0.6, easing: smoothstep, rotation: -0.7}\n        - {at: 1.2, easing: smoothstep, rotation: -0.3}\n        - {at: 1.8, easing: smoothstep, rotation: -0.9}\n        - {at: 2.4, easing: smoothstep, rotation: -0.3}\n        - {at: 3, easing: smoothstep, rotation: -0.7}\n        - {at: 4, easing: smoothstep}\n  osoitus:\n    duration: 4\n    joint_tracks:\n      upper_arm_l:\n        - {at: 0, easing: smoothstep}\n        - {at: 1, easing: smoothstep, rotation: 1.55}\n        - {at: 3, easing: smoothstep, rotation: 1.55}\n        - {at: 4, easing: smoothstep}\n      head:\n        - {at: 0, easing: smoothstep}\n        - {at: 1, easing: smoothstep, rotation: -0.08}\n