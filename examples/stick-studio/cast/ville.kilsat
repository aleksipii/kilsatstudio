64, rx: 10, ry: 7}\n          color: [185, 197, 201, 255]\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1.2\n            mode: behind\n      visemes:\n        part: mouth\n        map:\n          rest: rest\n          closed: closed\n          teeth_lip: teeth_lip\n          tongue_teeth: tongue_teeth\n          tongue_up: tongue_up\n          sibilant: sibilant\n          sh: sh\n          r: r\n          a: a\n          e: e\n          i: i\n          o: o\n          u: u\n      expressions:\n        happy:\n          - {part: brow_l, variant: happy}\n          - {part: brow_r, variant: happy}\n          - {part: mouth, variant: smile}\n        sad:\n          - {part: brow_l, variant: worried}\n          - {part: brow_r, variant: worried}\n          - {part: mouth, variant: frown}\n        surprised:\n          - {part: brow_l, variant: raised}\n          - {part: brow_r, variant: raised}\n          - {part: mouth, variant: o}\n        angry:\n          - {part: brow_l, variant: angry}\n          - {part: brow_r, variant: angry}\n          - {part: mouth, variant: closed}\n      hands:\n        left:\n          part: hand_l\n          shapes: {fist: fist, open: open, point: point, grip: grip, thumbs_up: thumbs_up}\n        right:\n          part: hand_r\n          shapes: {fist: fist, open: open, point: point, grip: grip, thumbs_up: thumbs_up}\n      eyes:\n        pupils: [pupil_l, pupil_r]\n        travel: 3.4\n        blink:\n          parts: [eye_l, eye_r, pupil_l, pupil_r]\n          variant: blink\n          interval: 3.23\n          duration: 0.12\n    acting: lively\n\nscenes:\n  - id: hahmo\n    duration: 5\n    events: []\n    composition:\n      background_color: '#f4f1e9'\n      camera:\n        - {at: 0, x: 0, y: 0, zoom: 1}\n      layers:\n        VILLE: {z: 0, visible: true}\n      actor_tracks:\n        VILLE:\n          - {at: 0, easing: smoothstep, x: 0.0, y: -20, scale_x: 1.8, scale_y: 1.8}\n      joint_tracks:\n