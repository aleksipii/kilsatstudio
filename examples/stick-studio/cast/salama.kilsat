  "source": "project: {title: Salama, width: 768, height: 1024, fps: 24}\n\ncharacters:\n  SALAMA:\n    asset: characters/salama-stick-library\n    default_pose: idle\n    rig:\n      version: 1\n      id: salama_stick_library\n      joints:\n        - {id: root, parent: null}\n        - {id: torso, parent: root, y: -85}\n        - {id: head, parent: torso, y: -110}\n        - {id: upper_arm_l, parent: torso, x: -29, y: -65, rotation: 0.16}\n        - {id: forearm_l, parent: upper_arm_l, y: 58}\n        - {id: hand_l, parent: forearm_l, y: 54}\n        - {id: upper_arm_r, parent: torso, x: 29, y: -65, rotation: -0.16}\n        - {id: forearm_r, parent: upper_arm_r, y: 58}\n        - {id: hand_r, parent: forearm_r, y: 54}\n        - {id: thigh_l, parent: root, x: -16, rotation: 0.055}\n        - {id: shin_l, parent: thigh_l, y: 70}\n        - {id: foot_l, parent: shin_l, y: 62}\n        - {id: thigh_r, parent: root, x: 16, rotation: -0.055}\n        - {id: shin_r, parent: thigh_r, y: 70}\n        - {id: foot_r, parent: shin_r, y: 62}\n      parts:\n        - id: cape\n          joint: torso\n          points: [[-33, -69], [33, -69], [59, 185], [0, 177], [-59, 185]]\n          color: [181, 71, 58, 255]\n          smooth: 2\n          outline:\n            color: [36, 40, 45, 255]\n            width: 1.5\n            mode: behind\n        - id: thigh_l\n          joint: thigh_l\n          points:\n            - [-5.17, 0.0]\n            - [-4.4774, -2.585]\n            - [-2.585, -4.4774]\n            - [-0.0, -5.17]\n            - [2.585, -4.4774]\n            - [4.4774, -2.585]\n            - [5.17, -0.0]\n            - [5.17, 70.0]\n            - [4.4774, 72.585]\n            - [2.585, 74.4774]\n            - [0.0, 75.17]\n            - [-2.585, 74.4774]\n            - [-4.4774, 72.585]\n            - [-5.17, 70.0]\n          color: [36, 40, 45, 255]\n        - id: shin_l\n          joint: shin_l\n          points:\n            - [-4.6, 0.0]\n            - [-3.9837,