      "id": "b01",
      "scene": "varikko",
      "start_s": 3,
      "end_s": 8,
      "kind": "dialogue",
      "actor": "RANE",
      "text": "It's just a tiny job. Take your own car. We need to keep costs down.",
      "source_text": "It's just a tiny job. Take your own car. We need to keep costs down.",
      "source_span": {
        "start_byte": 243,
        "end_byte": 311
      },
      "provenance": {
