      }
    },
    {
      "id": "b02",
      "scene": "varikko",
      "start_s": 8,
      "end_s": 13,
      "kind": "dialogue",
      "actor": "AINO",
      "text": "Whose costs? My car hasn't joined the company savings programme.",
      "source_text": "Whose costs? My car hasn't joined the company savings programme.",
      "source_span": {
        "start_byte": 327,
        "end_byte": 391
      },
      "provenance": {
        "kind": "authored",
        "rule_id": "ING-002",
        "rule_pack": "proposal-v1"
      }
    },
    {
      "id": "b03",
      "scene": "varikko",
      "start_s": 13,
      "end_s": 18,
      "kind": "dialogue",
      "actor": "RANE",
      "text": "Stop counting every mile. We need flexibility and a sense of shared responsibility.",
      "source_text": "Stop counting every mile. We need flexibility and a sense of shared responsibility.",
      "source_span": {
        "start_byte": 408,
        "end_byte": 491
      },
      "provenance": {
        "kind": "authored",
        "rule_id": "ING-002",
        "rule_pack": "proposal-v1"
      }
    },
    {
      "id": "b04",
      "scene": "varikko",
      "start_s": 18,
      "end_s": 24,
      "kind": "dialogue",
      "actor": "AINO",
      "text": "I've got both. And Kilsat. I'll log the trip so we can remember it the same way.",
      "source_text": "I've got both. And Kilsat. I'll log the trip so we can remember it the same way.",
      "source_span": {
        "start_byte": 508,
        "end_byte": 588
      },
      "provenance": {
        "kind": "authored",
        "rule_id": "ING-002",
        "rule_pack": "proposal-v1"
      }
    },
    {
      "id": "b05",
      "scene": "varikko",
      "start_s": 29,
      "end_s": 34,
      "kind": "dialogue",
      "actor": "RANE",
      "text": "I'd remember it as free. That would make the paperwork much lighter for us.",
      "source_text": "I'd remember it as free. That would make the paperwork much lighter for us.",
      "source_span": {
        "start_byte": 710,
        "end_byte": 785
      },
      "provenance": {
        "kind": "authored",
        "rule_id": "ING-002",
        "rule_pack": "proposal-v1"
      }
    },
    {
      "id": "b06",
      "scene": "varikko",
      "start_s": 34,
      "end_s": 39,
      "kind": "dialogue",
      "actor": "AINO",
      "text": "Then we're taking different routes. I'm driving this one. You're driving your point home.",
      "source_text": "Then we're taking different routes. I'm driving this one. You're driving your point home.",
      "source_span": {
        "start_byte": 802,
        "end_byte": 891
      },
      "provenance": {
