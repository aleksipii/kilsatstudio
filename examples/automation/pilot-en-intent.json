      "scene": "varikko",
      "start_s": 39,
      "end_s": 44,
      "kind": "dialogue",
      "actor": "RANE",
      "text": "What if I write that we agreed in a spirit of goodwill?",
      "source_text": "What if I write that we agreed in a spirit of goodwill?",
