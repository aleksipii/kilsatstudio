        "end_byte": 1058
      },
      "provenance": {
        "kind": "authored",
        "rule_id": "ING-002",
        "rule_pack": "proposal-v1"
      }
    },
    {
      "id": "b08",
      "scene": "varikko",
      "start_s": 44,
      "end_s": 49,
      "kind": "dialogue",
      "actor": "AINO",
      "text": "Kirjoita vain. Laita myös kilometrit. Hyvä henki ei kulje tankkiin.",
      "source_text": "Kirjoita vain. Laita myös kilometrit. Hyvä henki ei kulje tankkiin.",
