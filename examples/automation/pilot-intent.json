      }
    },
    {
      "id": "b03",
      "scene": "varikko",
      "start_s": 13,
      "end_s": 18,
      "kind": "dialogue",
      "actor": "RANE",
      "text": "Älä laske jokaista kilometriä. Täällä tarvitaan joustavaa asennetta ja yhteistä vastuuta.",
      "source_text": "Älä laske jokaista kilometriä. Täällä tarvitaan joustavaa asennetta ja yhteistä vastuuta.",
      "source_span": {
        "start_byte": 426,
        "end_byte": 522
      },
      "provenance": {
        "kind": "authored",
        "rule_id": "ING-002",
        "rule_pack": "proposal-v1"
      }
    },
    {
      "id": "b04",
      "scene": "varikko",
      "start_s": 18,
      "end_s": 24,
      "kind": "dialogue",
      "actor": "AINO",
      "text": "Minulla on molemmat. Ja Kilsat. Kirjaan matkan nyt, niin muistetaan se samalla tavalla.",
      "source_text": "Minulla on molemmat. Ja Kilsat. Kirjaan matkan nyt, niin muistetaan se samalla tavalla.",
      "source_span": {
        "start_byte": 539,
        "end_byte": 626
      },
      "provenance": {
        "kind": "authored",
        "rule_id": "ING-002",
        "rule_pack": "proposal-v1"
      }
    },
    {
      "id": "b05",
      "scene": "varikko",
      "start_s": 29,
      "end_s": 34,
      "kind": "dialogue",
      "actor": "RANE",
      "text": "Minä kyllä muistaisin sen ilmaisena. Se olisi meille hallinnollisesti paljon kevyempää.",
      "source_text": "Minä kyllä muistaisin sen ilmaisena. Se olisi meille hallinnollisesti paljon kevyempää.",
      "source_span": {
        "start_byte": 779,
        "end_byte": 870
      },
      "provenance": {
        "kind": "authored",
        "rule_id": "ING-002",
        "rule_pack": "proposal-v1"
      }
    },
    {
      "id": "b06",
      "scene": "varikko",
      "start_s": 34,
      "end_s": 39,
      "kind": "dialogue",
      "actor": "AINO",
      "text": "Silloin meillä olisi kaksi eri reittiä. Minä ajan tätä, sinä ajat asiaasi.",
      "source_text": "Silloin meillä olisi kaksi eri reittiä. Minä ajan tätä, sinä ajat asiaasi.",
      "source_span": {
        "start_byte": 887,
        "end_byte": 967
      },
      "provenance": {
        "kind": "authored",
        "rule_id": "ING-002",
        "rule_pack": "proposal-v1"
      }
    },
    {
      "id": "b07",
      "scene": "varikko",
      "start_s": 39,
      "end_s": 44,
      "kind": "dialogue",
      "actor": "RANE",
      "text": "Entä jos minä kirjoitan raporttiin, että sovittiin hyvässä hengessä?",
      "source_text": "Entä jos minä kirjoitan raporttiin, että sovittiin hyvässä hengessä?",
      "source_span": {
