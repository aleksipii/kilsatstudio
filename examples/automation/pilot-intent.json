      }
    },
    {
      "id": "b02",
      "scene": "varikko",
      "start_s": 8,
      "end_s": 13,
      "kind": "dialogue",
      "actor": "AINO",
      "text": "Saadaan kenen kulut kuriin? Minun autoni ei kuulu firman säästöohjelmaan.",
      "source_text": "Saadaan kenen kulut kuriin? Minun autoni ei kuulu firman säästöohjelmaan.",
      "source_span": {
