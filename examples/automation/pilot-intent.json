      "start_s": 3,
      "end_s": 8,
      "kind": "dialogue",
      "actor": "RANE",
      "text": "Tämä on ihan pieni keikka. Käy omalla autolla, niin saadaan kulut kuriin.",
      "source_text": "Tämä on ihan pieni keikka. Käy omalla autolla, niin saadaan kulut kuriin.",
      "source_span": {
        "start_byte": 241,
        "end_byte": 317
      },
      "provenance": {
