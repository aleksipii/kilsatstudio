  "assets": [],
  "format_version": 2,
  "source": "project:\n  title: Kilsat EN - The Live Demo\n  width: 1920\n  height: 1080\n  fps: 24\n  captions:\n    enabled: true\n    font_size: 54\n    speaker_fill: {AINO: '#ffdf7c', RANE: '#ffffff'}\n    outline_width: 4\n    bottom_margin: 0.035\n    max_width: 0.9\n    line_height: 1.08\n    uppercase: false\n    background: '#17232b'\n\ncharacters:\n  AINO:\n    asset: characters/aino-original\n    default_pose: idle\n    rig:\n      version: 1\n      id: aino_original\n      joints:\n        - {id: root, parent: null}\n        - {id: torso, parent: root}\n        - {id: head, parent: torso, y: -144}\n        - {id: arm_l, parent: torso, x: -43, y: -103}\n        - {id: arm_r, parent: torso, x: 43, y: -103}\n      parts:\n        - id: leg_l\n          joint: root\n          points: [[-30, 15], [-4, 15], [-7, 116], [-29, 116]]\n          color: [52, 66, 81, 255]\n          smooth: 2\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: leg_r\n          joint: root\n          points: [[4, 15], [30, 15], [29, 116], [7, 116]]\n          color: [52, 66, 81, 255]\n          smooth: 2\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: shoe_l\n          joint: root\n          ellipse: {cx: -20, cy: 120, rx: 20, ry: 9}\n          color: [38, 41, 47, 255]\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: shoe_r\n          joint: root\n          ellipse: {cx: 20, cy: 120, rx: 20, ry: 9}\n          color: [38, 41, 47, 255]\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: torso\n          joint: torso\n          points: [[-30, -116], [30, -116], [45, -92], [43, 22], [-43, 22], [-45, -92]]\n          color: [42, 136, 132, 255]\n          smooth: 3\n          outline:\n            width: 2.4\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: collar\n          joint: torso\n          points: [[-16, -116], [16, -116], [0, -92]]\n          color: [231, 224, 208, 255]\n          smooth: 2\n          outline:\n            width: 1.3\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: sleeve_l\n          joint: arm_l\n          points: [[-11, -3], [11, -3], [10, 66], [-10, 66]]\n          color: [42, 136, 132, 255]\n          smooth: 3\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hand_l\n          joint: arm_l\n          ellipse: {cx: 0, cy: 72, rx: 10, ry: 12}\n          color: [233, 184, 151, 255]\n          outline:\n            width: 1.8\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: sleeve_r\n          joint: arm_r\n          points: [[-11, -3], [11, -3], [10, 66], [-10, 66]]\n          color: [42, 136, 132, 255]\n          smooth: 3\n          outline:\n            width: 2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hand_r\n          joint: arm_r\n          ellipse: {cx: 0, cy: 72, rx: 10, ry: 12}\n          color: [233, 184, 151, 255]\n          outline:\n            width: 1.8\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: phone_body\n          joint: arm_r\n          points:\n            - [24.048, 99.312]\n            - [23.167, 100.83]\n            - [21.772, 101.897]\n            - [20.075, 102.348]\n            - [18.335, 102.115]\n            - [-28.034, 86.274]\n            - [-29.553, 85.393]\n            - [-30.619, 83.998]\n            - [-31.07, 82.301]\n            - [-30.837, 80.561]\n            - [-24.048, 60.688]\n            - [-23.167, 59.17]\n            - [-21.772, 58.103]\n            - [-20.075, 57.652]\n            - [-18.335, 57.885]\n            - [28.034, 73.726]\n            - [29.553, 74.607]\n            - [30.619, 76.002]\n            - [31.07, 77.699]\n            - [30.837, 79.439]\n          color: [34, 37, 44, 255]\n          outline:\n            width: 1.4\n            mode: behind\n            color: [16, 18, 22, 255]\n        - id: phone_glass\n          joint: arm_r\n          points:\n            - [20.544, 97.692]\n            - [20.054, 98.535]\n            - [19.279, 99.128]\n            - [18.337, 99.378]\n            - [17.37, 99.249]\n            - [-25.517, 84.598]\n            - [-26.36, 84.108]\n            - [-26.953, 83.333]\n            - [-27.203, 82.391]\n            - [-27.074, 81.424]\n            - [-20.544, 62.308]\n            - [-20.054, 61.465]\n            - [-19.279, 60.872]\n            - [-18.337, 60.622]\n            - [-17.37, 60.751]\n            - [25.517, 75.402]\n            - [26.36, 75.892]\n            - [26.953, 76.667]\n            - [27.203, 77.609]\n            - [27.074, 78.576]\n          color: [19, 50, 43, 255]\n        - id: phone_clock\n          joint: arm_r\n          points: [[13.619, 77.255], [9.093, 90.504], [4.361, 88.887], [8.887, 75.639]]\n          color: [242, 239, 224, 255]\n        - id: phone_reflection\n          joint: arm_r\n          points: [[27.882, 76.211], [24.973, 84.727], [10.849, 70.391]]\n          color: [255, 255, 255, 46]\n        - id: thumb\n          joint: arm_r\n          ellipse: {cx: -3.991, cy: 63.842, rx: 5.5, ry: 8}\n          color: [233, 184, 151, 255]\n          outline:\n            width: 1.4\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: hair_back\n          joint: head\n          ellipse: {cx: 0, cy: -25, rx: 40, ry: 46}\n          color: [74, 45, 43, 255]\n          outline:\n            width: 2.2\n            mode: behind\n            color: [27, 28, 36, 255]\n        - id: face\n          joint: head\n          ellipse: {cx: 0, cy: -24, rx: 31, ry: 37}\n          color: [233, 184, 151, 255]\n          outline:\n            wid